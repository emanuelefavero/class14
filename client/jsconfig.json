{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
