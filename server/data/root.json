{
  "name": "Class14",
  "message": "Class14 — Learning Hub and Student Showcase for WDPT14",
  "status": "Class14 catalog APIs and static assets available; frontend adaptation is the next step",
  "documentation": "docs/API-CONTRACT.md (repository file)",
  "endpoints": [
    {
      "path": "/",
      "methods": [
        {
          "method": "GET",
          "description": "Informazioni generali e stato del backend Class14"
        }
      ]
    },
    {
      "path": "/api/projects",
      "methods": [
        {
          "method": "GET",
          "description": "Lista progetti; ricerca q e filtro topic opzionali"
        }
      ]
    },
    {
      "path": "/api/projects/:slug",
      "methods": [
        {
          "method": "GET",
          "description": "Dettaglio con studenti/repository, PDF e risorse"
        }
      ]
    },
    {
      "path": "/api/students",
      "methods": [
        {
          "method": "GET",
          "description": "Lista studenti; ricerca q e filtro topic opzionali"
        }
      ]
    },
    {
      "path": "/api/students/:github_username",
      "methods": [
        {
          "method": "GET",
          "description": "Profilo con repository disponibili e topics derivati"
        }
      ]
    },
    {
      "path": "/api/cheatsheets",
      "methods": [
        {
          "method": "GET",
          "description": "Catalogo PDF con progetti collegati; ricerca q e filtro topic opzionali"
        }
      ]
    },
    {
      "path": "/api/resources",
      "methods": [
        {
          "method": "GET",
          "description": "Catalogo risorse con progetti collegati; ricerca q e filtro topic opzionali"
        }
      ]
    },
    {
      "path": "/api/topics",
      "methods": [
        {
          "method": "GET",
          "description": "Tag unici con conteggio progetti"
        }
      ]
    },
    {
      "path": "/api/topics/:name",
      "methods": [
        {
          "method": "GET",
          "description": "Progetti e materiali indiretti del topic"
        }
      ]
    },
    {
      "path": "/api/stats",
      "methods": [
        {
          "method": "GET",
          "description": "Contatori globali del catalogo"
        }
      ]
    }
  ]
}
